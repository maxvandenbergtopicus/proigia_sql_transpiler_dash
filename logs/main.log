SQL for CTE detection (first 500 chars): SELECT
  CAST(row_key AS DECIMAL),
  nummer,
  indicator,
  teller,
  noemer,
  CASE
    WHEN noemer IS NULL
    THEN NULL
    WHEN indicator ILIKE 'gemiddelde duur%'
    THEN ROUND(CAST(teller AS DECIMAL) / CAST(GREATEST(noemer, 1) AS DECIMAL) / 365, 1)
    WHEN indicator ILIKE 'gemiddeld%'
    THEN ROUND(CAST(teller AS DECIMAL) / CAST(GREATEST(noemer, 1) AS DECIMAL), 1)
    ELSE ROUND(CAST(teller AS DECIMAL) / CAST(GREATEST(noemer, 1) AS DECIMAL) * 100, 1)
  END AS percentage
FROM dm_popman_in
