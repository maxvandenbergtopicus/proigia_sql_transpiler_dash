    THEN ROUND(CAST(teller AS DECIMAL) / CAST(GREATEST(noemer, 1) AS DECIMAL) / 365, 1)
    ELSE ROUND(CAST(teller AS DECIMAL) / CAST(GREATEST(noemer, 1) AS DECIMAL) * 100, 1)
  END AS percentage
FROM adhd_indicatoren_abs_adhb
