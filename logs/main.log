WITH nhgnr_verrijking AS (
  SELECT
    patient_id,
    b.nhgnummer AS nhgnr,
    datum,
    uitslag,
    COALESCE(aw.output, uitslag_num) AS uitslag_num,
    uitslag_cleaned,
    opmerking,
    eind_periode
  FROM bepaling AS b
  CROSS JOIN nhg_jaarverslag_v2_0_53530025_years
  LEFT JOIN indelingen.alfanumerieke_waarden AS aw
    ON b.nhgnummer = aw.nhgnr AND aw.input = uitslag
