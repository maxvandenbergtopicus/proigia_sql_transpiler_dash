    THEN CAST((
      CAST((
        1000 * teller
      ) AS DOUBLE) / noemer
    ) AS INT)
    ELSE ROUND(CAST(teller AS DECIMAL) / CAST(GREATEST(noemer, 1) AS DECIMAL) * 100, 1)
  END AS uitkomst
FROM ab_stewardship_indicatoren_abs
ORDER BY
  nr
