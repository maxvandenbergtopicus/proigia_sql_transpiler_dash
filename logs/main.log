  patient_id,
  atc AS categorie,
  name AS naam,
  voorschrijfdatum,
  atc_code,
  CASE
    WHEN einddatum >= DATEADD(DAY, -28, CAST('${peildatum}' AS DATE))
    AND code_stopzetting IS NULL
    AND reden_stopzetting IS NULL
