    ROW_NUMBER() OVER (PARTITION BY patient_id ORDER BY patient_id) AS _row_number
  FROM patient
  WHERE
    (
      categorie = 'V' OR categorie IS NULL
    )
) AS _t
WHERE
  _row_number = 1
