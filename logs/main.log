    THEN ROUND(CAST(teller AS DECIMAL) / CAST(GREATEST(noemer, 1) AS DECIMAL), 2)
    ELSE ROUND(CAST(teller AS DECIMAL) / CAST(GREATEST(noemer, 1) AS DECIMAL) * 100, 1)
  END AS uitkomst
FROM inzicht_poh_ggz_indic_wachttijd_abs
ORDER BY
  row_key
