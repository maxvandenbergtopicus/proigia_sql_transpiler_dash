WITH prepare AS (
WITH alle_hb AS
(
    SELECT
        patient_id,
        memo,
        datum,
        uitslag_waarde
    FROM gpri_verborgen_nierschade_meetwaarden_filter
    WHERE omschrijving ilike '%hoofdbehandelaar%'
    ORDER BY patient_id, memo, uitslag_waarde, datum desc
