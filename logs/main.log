    memo||'_db',
    ARRAY_CONSTRUCT(CASE WHEN array_length(uitslagen, 1) > 1 THEN 1 ELSE 0 END::varchar,
            datum::varchar, uitslagen::varchar) AS dubbel
FROM grouping_uitslagen
ORDER BY patient_id, memo, datum desc
)
