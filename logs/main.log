SQL before CREATE VIEW removal (first 500 chars): CREATE VIEW o_lab_meetwaarden_ooit AS
SELECT
  patient_id,
  MAX(
    CASE
      WHEN nhgnr = 35
      AND (
        (
          geslacht ILIKE 'm' AND CAST(uitslag_waarde AS DECIMAL) >= 50
        )
        OR (
          (
            geslacht ILIKE 'v' OR geslacht IS NULL
          )
          AND CAST(uitslag_waarde AS DECIMAL) >= 40
        )
      )
      THEN 1
      ELSE 0
